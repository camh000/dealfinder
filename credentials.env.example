DB_USER=admin
DB_PASSWORD=yourpasswordhere
DB_HOST=192.168.1.104
DB_PORT=3305
DB_NAME=Scraper

# Proxy fallback — pay-per-use, only charged when curl_cffi is blocked by Akamai.
# Sign up at https://www.zyte.com/zyte-api/ (no subscription, no minimum spend)
ZYTE_API_KEY=your_zyte_api_key_here
# Number of times to retry a Zyte HTTP 520 (transient error) before giving up (default: 3)
ZYTE_MAX_RETRIES=3

# Hours after auction end before a targeted sold-listing search is run to resolve
# any outcomes the regular scraper missed (default: 6)
OUTCOME_VERIFY_HOURS=6
# Days after auction end before a still-unresolved outcome is permanently
# marked as gave-up and excluded from future verification retries (default: 7)
OUTCOME_GIVE_UP_DAYS=7

# Minutes between full query-list scrapes across all categories (default: 60)
FULL_SCRAPE_INTERVAL_MINUTES=60

# ── Monitoring & notifications (all optional) ─────────────────────────────────

# Uptime Kuma push monitor URL — pinged only after a healthy full scrape
# (>=1 category succeeded AND >=1 row touched), so parser drift / total fetch
# failure / dead DB all surface as "down" in Kuma.
KUMA_PUSH_URL=

# Home Assistant push notifications for newly surfaced deals.
# HA_NOTIFY_SERVICE is the bit after "notify." (e.g. mobile_app_your_phone).
HA_URL=http://192.168.1.104:8123
HA_TOKEN=
HA_NOTIFY_SERVICE=

# Server-side deal surfacing thresholds (mirror the UI defaults)
SURFACE_WINDOW_HOURS=2
SURFACE_MIN_DISCOUNT=20

# Notification gate: skip the push when the outcome-calibrated predicted
# final price leaves less than this % below market (deals are still recorded).
SURFACE_MIN_PREDICTED_DISCOUNT=10

# Listings not seen by any scrape within this many minutes are dropped from
# the deal feed — catches seller-cancelled listings that would otherwise show
# as phantom deals until their original end time (default: 90).
STALE_DEAL_MINUTES=90

# Market medians only trust sales within this many days (default: 120) —
# component prices drift, so year-old sales shouldn't set today's value.
MARKET_STATS_DAYS=120

# Deals from sellers below this positive-feedback % are hidden (default: 90).
# Only applies once a seller has 3+ feedback — new accounts aren't penalised.
MIN_SELLER_FEEDBACK_PCT=90

# HTTP Basic Auth for the dashboard + API — enabled when BOTH are set.
# Leave blank to keep the app open (e.g. LAN-only deployments).
HTTP_USER=
HTTP_PASS=
